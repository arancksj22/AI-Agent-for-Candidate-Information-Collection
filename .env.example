CANDIDATE_API_BASE_URL=https://candidate-db-api.service.external.usea2.aws.prodigaltech.com
CANDIDATE_API_KEY=your_candidate_api_key
GEMINI_API_KEY=your_gemini_api_key
# Optional second key (separate quota), used when the first runs out
GEMINI_FALLBACK_API_KEY=

# Optional (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_BUDGET=512
# NUDGE_AFTER_SECONDS=180
# GIVE_UP_AFTER_SECONDS=360
# MAX_TURNS=30
# LLM_CACHE=0                 # 1 = reuse identical LLM responses (dev only, saves quota)

# Optional AWS replay of failed writes (python infra/aws.py deploy prints these)
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account>/candidate-writes
# AWS_REGION=us-east-1
